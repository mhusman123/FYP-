// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  EDUCATOR
  ADMIN
}

enum SubmissionStatus {
  SUBMITTED
  GRADED
  UNDER_REVIEW
  RETURNED
}

enum AdjustmentReason {
  MEDICAL
  FAMILY_EMERGENCY
  TECHNICAL_ISSUES
  ACCESSIBILITY
  OTHER
}

enum AdjustmentStatus {
  PENDING
  APPROVED
  REJECTED
  REQUIRES_INFO
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          UserRole  @default(STUDENT)
  totalPoints   Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts            Account[]
  sessions            Session[]
  educatedCourses     Course[]                   @relation("CourseEducator")
  enrolledCourses     CourseEnrollment[]
  submissions         Submission[]
  userBadges          UserBadge[]
  adjustmentRequests  GradeAdjustmentRequest[]   @relation("StudentRequests")
  reviewedRequests    GradeAdjustmentRequest[]   @relation("ReviewerRequests")

  @@map("users")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Course {
  id            String   @id @default(cuid())
  name          String
  code          String   @unique
  description   String?
  semester      String
  year          Int
  credits       Int      @default(3)
  prerequisites Json     @default("[]") // Array of course codes that are prerequisites
  difficulty    String   @default("INTERMEDIATE") // BEGINNER, INTERMEDIATE, ADVANCED
  isActive      Boolean  @default(true)
  educatorId    String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  educator    User                 @relation("CourseEducator", fields: [educatorId], references: [id])
  enrollments CourseEnrollment[]
  assignments Assignment[]

  @@map("courses")
}

model CourseEnrollment {
  id        String   @id @default(cuid())
  courseId  String
  studentId String
  enrolledAt DateTime @default(now())

  course  Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student User   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([courseId, studentId])
  @@map("course_enrollments")
}

model Assignment {
  id               String   @id @default(cuid())
  title            String
  description      String
  instructions     String
  dueDate          DateTime
  maxPoints        Int
  allowedFileTypes Json
  maxFileSize      Int      @default(10485760) // 10MB default
  isPublished      Boolean  @default(false)
  courseId         String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  submissions Submission[]

  @@map("assignments")
}

model Submission {
  id              String           @id @default(cuid())
  assignmentId    String
  studentId       String
  fileUrl         String
  fileName        String
  fileSize        Int
  submittedAt     DateTime         @default(now())
  isLate          Boolean          @default(false)
  plagiarismScore Float?
  grade           Float?
  feedback        String?
  status          SubmissionStatus @default(SUBMITTED)

  assignment         Assignment               @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student            User                     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  plagiarismReport   PlagiarismReport?
  adjustmentRequests GradeAdjustmentRequest[]

  @@unique([assignmentId, studentId])
  @@map("submissions")
}

model Badge {
  id          String @id @default(cuid())
  name        String @unique
  description String
  icon        String
  color       String
  criteria    Json   // Store BadgeCriteria as JSON
  points      Int

  userBadges UserBadge[]

  @@map("badges")
}

model UserBadge {
  id       String   @id @default(cuid())
  userId   String
  badgeId  String
  earnedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@map("user_badges")
}

model PlagiarismReport {
  id           String   @id @default(cuid())
  submissionId String   @unique
  overallScore Float
  sources      Json     // Store PlagiarismSource[] as JSON
  generatedAt  DateTime @default(now())

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@map("plagiarism_reports")
}

model GradeAdjustmentRequest {
  id                   String           @id @default(cuid())
  submissionId         String
  studentId            String
  reason               AdjustmentReason
  description          String
  supportingDocuments  Json             @default("[]")
  requestedAt          DateTime         @default(now())
  status               AdjustmentStatus @default(PENDING)
  reviewedBy           String?
  reviewedAt           DateTime?
  decision             String?
  adjustedGrade        Float?

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  student    User       @relation("StudentRequests", fields: [studentId], references: [id], onDelete: Cascade)
  reviewer   User?      @relation("ReviewerRequests", fields: [reviewedBy], references: [id])

  @@map("grade_adjustment_requests")
}